# Copy to .env and edit. In production set DATA_KEY and JWT_SECRET explicitly and back them up:
# losing DATA_KEY makes encrypted face templates and snapshots unreadable.
NODE_ENV=production
PORT=3000
TRUST_PROXY=1
DATA_DIR=/data
DATA_KEY=            # 64 hex chars:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=          # any long random string
TOKEN_TTL_HOURS=12
TZ_OFFSET_HOURS=2    # Kigali, used for daily streaks
SERVICES=all         # or a subset: identity,content,assess,proctor,social,admin,realtime
ADMIN_EMAIL=admin@yourschool.example
ADMIN_PASSWORD=      # first-run admin account (change it after signing in)
SEED_DEMO=0          # 1 loads demo users and courses (never in production)
FACE_MATCH_THRESHOLD=0.5
ID_MATCH_THRESHOLD=0.55
PROCTOR_RETENTION_DAYS=30
ANTHROPIC_API_KEY=   # optional: Study Buddy uses Claude; without it a rule-based tutor answers
ANTHROPIC_MODEL=claude-haiku-5-5
COCO_MODEL_URL=      # optional: self-hosted COCO-SSD model.json for object detection in room scans
METRICS_TOKEN=       # optional: bearer token required for /metrics
HELPLINE_TEXT=       # shown to learners when the Study Buddy detects distress
